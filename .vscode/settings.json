{
  // 인터프리터: 경로를 지정하지 않는다. Python 확장이 작업 폴더의 .venv를 자동으로 찾는다
  // (Windows: .venv/Scripts/python.exe, Mac: .venv/bin/python).
  // python.defaultInterpreterPath에 .venv "폴더"를 넣으면 Pylance가 패키지를 못 찾으니 넣지 않는다.
  "python.terminal.activateEnvironment": true,

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    // 저장할 때 Ruff로 import 정리 (표준 라이브러리 / 외부 패키지 묶음 나누기, 정렬)
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  // CSV는 텍스트 에디터 + Rainbow CSV(열마다 색), 엑셀은 Excel Viewer(보기 전용 표)로 연다
  "files.associations": { "*.csv": "csv" },
  "workbench.editorAssociations": {
    "*.csv": "default",
    "*.xlsx": "gc-excelviewer-excel-editor"
  },

  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
